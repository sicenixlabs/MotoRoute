{
  "name": "motoruta-mobile-production",
  "version": "1.0.0",
  "description": "MotoRuta — Aplicación Móvil Nativa iOS (App Store) y Android (Google Play) para Motociclistas",
  "main": "www/index.html",
  "scripts": {
    "sync": "cap sync",
    "open:ios": "cap open ios",
